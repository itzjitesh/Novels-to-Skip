# Copy this file to .env (in the project root) and fill in the values.
# Never commit .env — it's already in .gitignore.

# MongoDB connection string. The part after ".net/" is the database name; v1 used NovelDB.
# e.g. mongodb+srv://itzjitesh:<password>@cluster0.90lxjmb.mongodb.net/NovelDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/NovelDB

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that become admins automatically when they sign up
ADMIN_EMAILS=singhjitesh469@gmail.com

# Public URL of the site (used in the sitemap and link previews)
SITE_URL=http://localhost:5173

# Where the React dev server runs (only used in development for CORS)
CLIENT_URL=http://localhost:5173

# Set to true to let regular users publish without admin review
AUTO_PUBLISH_USER_POSTS=false

# Optional: enables "Draft it for me" on the write page
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

PORT=5000
